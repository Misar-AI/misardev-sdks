{
  "name": "misarai/misardev-php",
  "description": "PHP client for the Misar.Dev API: create projects, write files, build and deploy apps, start from templates, OpenAI-compatible chat completions, code search and usage — every route generated from the API, with retries, typed plan-limit errors carrying the upgrade offer, and SSE streaming.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://www.misar.dev",
  "keywords": [
    "misardev",
    "misar",
    "misar-dev",
    "app-builder",
    "deploy",
    "hosting",
    "templates",
    "chat-completions",
    "openai-compatible",
    "code-search",
    "rag",
    "sse",
    "streaming",
    "api-client",
    "sdk",
    "misardev-php"
  ],
  "authors": [
    {
      "name": "Misar.AI",
      "email": "hello@misar.io",
      "homepage": "https://misar.io",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/Misar-AI/misardev-sdks/issues",
    "source": "https://github.com/Misar-AI/misardev-sdks/tree/main/php",
    "docs": "https://docs.misar.io/dev"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "MisarDev\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MisarDev\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
