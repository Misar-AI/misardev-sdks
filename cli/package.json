{
  "name": "@misardev/cli",
  "version": "1.0.0",
  "description": "Misar.Dev from the terminal: every API route as a command — create, build and deploy projects, write files, manage domains and env vars, start from templates, search code, stream chat completions. Plan refusals render as an upgrade card.",
  "type": "module",
  "bin": {
    "misardev": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "misardev",
    "misar",
    "cli",
    "command-line",
    "app-builder",
    "ai-app-builder",
    "deploy",
    "hosting",
    "projects",
    "templates",
    "code-search",
    "chat-completions",
    "openai-compatible",
    "sse"
  ],
  "author": "Misar.AI <hello@misar.io> (https://misar.io)",
  "license": "MIT",
  "homepage": "https://www.misar.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misar-AI/misardev-sdks.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/Misar-AI/misardev-sdks/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@misardev/sdk": "file:../typescript",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
