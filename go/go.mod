// The module path must match the repository that serves it: the SDK mirror at
// github.com/Misar-AI/misardev-sdks keeps each language in a subdirectory, so
// this module lives at the /go suffix and its release tags are `go/vX.Y.Z`
// (the version comes from sdks/VERSION, never from this file).
module github.com/Misar-AI/misardev-sdks/go

go 1.22
